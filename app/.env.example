# Optional: fetch library.json from a URL instead of the bundled copy. Copy to .env.local (gitignored)
# and restart `npm start`. Unset: the app uses src/data/library.bundled.json (`npm run bundle-library`).
# .env*.local is never uploaded to EAS (../.easignore), so TestFlight builds always use the bundled copy.
#
# Live-reload a fresh pipeline build without re-bundling: run `npm run library`, then:
#   simulator: EXPO_PUBLIC_LIBRARY_URL=http://localhost:8787/library.json
#   phone:     the "phone:" URL that `npm run library` prints (same Wi-Fi)
EXPO_PUBLIC_LIBRARY_URL=
